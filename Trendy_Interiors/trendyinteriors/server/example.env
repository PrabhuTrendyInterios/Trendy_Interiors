# MongoDB Connection URI (Atlas)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/databasename?retryWrites=true&w=majority

# Environment
NODE_ENV=development

# JWT Secret for authentication
JWT_SECRET=your_secret_key_here

# Admin email for notifications
ADMIN_EMAIL=admin@example.com

# Email sender address
EMAIL_FROM=noreply@example.com

# Admin Dashboard URL for email links
ADMIN_DASHBOARD_URL=https://yourdomain.com/admin

# MongoDB Fallback to local database
MONGODB_FALLBACK_LOCAL=true

# MongoDB Local Connection URI
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/trendydev

# Server Port
PORT=5000

# Groq API Key (for AI/chatbot features)
GROQ_API_KEY=your_groq_api_key_here

# SendGrid API Key (for email service)
SENDGRID_API_KEY=your_sendgrid_api_key_here
